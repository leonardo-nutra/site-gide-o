# ── Obrigatório ──────────────────────────────────────────────
# Supabase: Project Settings > API (use a chave "anon"/"publishable", nunca a service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Marketing (opcional) ─────────────────────────────────────
# Meta (Facebook/Instagram) Pixel ID — Gerenciador de Eventos > Pixels
NEXT_PUBLIC_META_PIXEL_ID=

# API de Conversões da Meta (envio de eventos pelo servidor).
# SEGREDO: cadastre só no painel da Vercel (Settings > Environment Variables). Nunca no código.
META_CAPI_TOKEN=
# Só enquanto testa em "Testar eventos"; apague depois.
META_TEST_EVENT_CODE=
